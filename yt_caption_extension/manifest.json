{
  "manifest_version": 3,
  "name": "YouTube Caption Sender",
  "version": "1.0",
  "description": "Sends YouTube closed captions to a local WebSocket server for overlay display.",
  "permissions": [],
  "host_permissions": ["*://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/watch*", "*://*.youtube.com/embed/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
